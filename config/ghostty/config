# Theme
theme = TokyoNight Storm

# Fonts
font-family = Operator Mono
font-family-bold = Operator Mono Bold
font-family-italic = Operator Mono Bold Italic
font-family-bold-italic = Operator Mono Bold Italic
font-family = Symbols Nerd Font
font-family = DejaVu Sans Mono
font-size = 12
adjust-cell-height = 25%

# Splits
split-divider-color = #292e42
unfocused-split-fill = #1f2335
unfocused-split-opacity = 0.85

# GTK (Linux)
gtk-wide-tabs = false
gtk-toolbar-style = flat
gtk-titlebar-style = tabs
window-theme = ghostty
window-titlebar-background = #1f2335
window-padding-x = 0
window-padding-y = 0
gtk-custom-css = style.css

# Keybindings
keybind = ctrl+b>shift+quote=new_split:down
keybind = ctrl+b>shift+digit_5=new_split:right
keybind = ctrl+b>z=toggle_split_zoom

# Tab navigation
keybind = shift+arrow_right=next_tab
keybind = shift+arrow_left=previous_tab

# Pane navigation
keybind = alt+arrow_left=goto_split:left
keybind = alt+arrow_right=goto_split:right
keybind = alt+arrow_up=goto_split:up
keybind = alt+arrow_down=goto_split:down

# Fullscreen
keybind = f11=toggle_fullscreen
